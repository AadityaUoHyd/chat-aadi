'use client';

import { useEffect } from 'react';
import { usePathname, useRouter } from 'next/navigation';

export default function DashboardRedirect() {
  const router = useRouter();
  const pathname = usePathname();

  useEffect(() => {
    // Extract the sub-route from the pathname
    const subRoute = pathname.replace('/main/dashboard', '');
    
    // If we're at the root dashboard path, redirect to main
    if (!subRoute || subRoute === '/') {
      router.replace('/(main)');
    } else {
      // Otherwise, show the appropriate content based on the sub-route
      // For now, we'll just redirect to main, but you can add specific logic here
      router.replace('/(main)');
    }
  }, [pathname, router]);

  return null;
}
